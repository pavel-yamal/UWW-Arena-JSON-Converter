# Адрес Arena (из контейнера; если Arena на этом же ПК — host.docker.internal)
ARENA_URL=http://host.docker.internal:8080
# OAuth2 client_credentials (клиент создаётся в Arena). Пусто = без авторизации
ARENA_CLIENT_ID=
ARENA_CLIENT_SECRET=
ARENA_TOKEN_PATH=/oauth/v2/token
# Либо готовый Bearer-токен
ARENA_API_TOKEN=
# UUID турнира; пусто = /api/json/arena/current-event
ARENA_EVENT_ID=
# Только эти ковры (имя или id через запятую); пусто = все
MATS=
# Период опроса Arena, сек
POLL_INTERVAL=1
# Единица числового таймера из Arena: s | ms
TIMER_UNIT=s
# Свой файл сопоставления полей
MAPPING_FILE=
# Префикс столбцов в /vmix: name (A_red_name) | index (mat1_red_name)
VMIX_KEY=name
# Отладочные /raw/* эндпоинты
ENABLE_RAW=1
